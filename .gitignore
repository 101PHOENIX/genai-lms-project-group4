# Audio takes: large and regenerable. Each run keeps summary.json + qc.json as evidence;
# the promoted takes live in unity/Assets/Audio/.
baselines/*-audio-*/*.wav
baselines/*-audio-*/*.mp3
baselines/*-audio-*/*.ogg
baselines/*-audio-*/*.flac
baselines/*-audio-*/*.aif
baselines/*-audio-*/*.aiff

